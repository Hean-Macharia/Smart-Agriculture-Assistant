APP_NAME=Smart Agriculture Advisory and Market Linkage API
APP_ENV=development
DEBUG=true
CORS_ALLOWED_ORIGINS=

# For Atlas, use the URI from Connect and keep the app database separate below.
# Standard Atlas database-user example: mongodb+srv://USER:ENCODED_PASSWORD@CLUSTER/?retryWrites=true&w=majority&authSource=admin
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=smart_agriculture
# Optional comma-separated browser origins, e.g. https://your-frontend.example
CORS_ALLOWED_ORIGINS=

JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-token-at-least-32-characters-long

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ENVIRONMENT=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

WEATHER_API_KEY=

# Optional model assets. Provide a trained Keras model and JSON class labels before enabling predictions.
DISEASE_MODEL_PATH=uploads/models/crop_disease.keras
DISEASE_LABELS_PATH=uploads/models/crop_disease_labels.json
DISEASE_IMAGE_MAX_BYTES=8388608
DISEASE_INPUT_SIZE=224

# Africa's Talking supports sandbox simulation and production delivery.
SMS_PROVIDER=africas_talking
SMS_ENVIRONMENT=sandbox
SMS_USERNAME=sandbox
SMS_AUTO_DISPATCH=false
# Add the API key from the Africa's Talking Sandbox app. Never commit .env.
SMS_API_KEY=
SMS_SENDER_ID=
# Only used by SMS_PROVIDER=http (generic gateway adapter).
SMS_API_URL=

PAYMENT_PROVIDER=mock
ESCROW_PROVIDER=mock
PLATFORM_COMMISSION_BPS=500
