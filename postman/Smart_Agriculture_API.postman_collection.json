{
  "info": {
    "_postman_id": "5d385b41-1830-4ecf-a160-81bfa9e4215f",
    "name": "Smart_Agriculture_API",
    "description": "Phase 1 starter requests. MongoDB readiness is a live connectivity check; no external providers are called in this phase.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{"key": "base_url", "value": "http://127.0.0.1:8000"}],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health",
            "description": "No authentication. HTTP 200 means the API process responds."
          },
          "event": [{
            "listen": "test",
            "script": {"type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('status is ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('service name is returned', () => pm.expect(pm.response.json().service).to.be.a('string'));"
            ]}
          }],
          "response": [{
            "name": "200 OK",
            "originalRequest": {"method": "GET", "header": [], "url": "{{base_url}}/health"},
            "status": "OK",
            "code": 200,
            "_postman_previewlanguage": "json",
            "header": [{"key": "content-type", "value": "application/json"}],
            "cookie": [],
            "body": "{\"status\":\"ok\",\"service\":\"Smart Agriculture Advisory and Market Linkage API\"}"
          }]
        },
        {
          "name": "MongoDB readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/health/ready",
            "description": "No authentication. Returns 200 when MongoDB responds to ping or 503 when it is unavailable."
          },
          "event": [{
            "listen": "test",
            "script": {"type": "text/javascript", "exec": [
              "pm.test('MongoDB readiness status is explicit', () => pm.expect([200, 503]).to.include(pm.response.code));",
              "if (pm.response.code === 200) pm.test('database connected', () => pm.expect(pm.response.json().database).to.eql('connected'));",
              "if (pm.response.code === 503) pm.test('database unavailable is explicit', () => pm.expect(pm.response.json().detail.database).to.eql('unavailable'));"
            ]}
          }],
          "response": [
            {
              "name": "200 MongoDB connected",
              "originalRequest": {"method": "GET", "header": [], "url": "{{base_url}}/health/ready"},
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{"key": "content-type", "value": "application/json"}],
              "cookie": [],
              "body": "{\"status\":\"ready\",\"database\":\"connected\"}"
            },
            {
              "name": "503 MongoDB unavailable",
              "originalRequest": {"method": "GET", "header": [], "url": "{{base_url}}/health/ready"},
              "status": "Service Unavailable",
              "code": 503,
              "_postman_previewlanguage": "json",
              "header": [{"key": "content-type", "value": "application/json"}],
              "cookie": [],
              "body": "{\"detail\":{\"status\":\"not_ready\",\"database\":\"unavailable\"}}"
            }
          ]
        }
      ]
    }
  ]
}
